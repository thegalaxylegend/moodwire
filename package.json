{
  "name": "moodwire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "q:turbo": "npx tsx scripts/turbo-pipeline.ts --workers=30 --batch-size=10",
    "q:turbo-dry": "npx tsx scripts/turbo-pipeline.ts --workers=30 --batch-size=10 --dry-run",
    "q:turbo-jee": "npx tsx scripts/turbo-pipeline.ts --workers=30 --batch-size=10 --exam=JEEMains",
    "q:turbo-neet": "npx tsx scripts/turbo-pipeline.ts --workers=30 --batch-size=10 --exam=NEET",
    "q:turbo-board": "npx tsx scripts/turbo-pipeline.ts --workers=30 --batch-size=10 --exam=Board",
    "q:turbo-curation": "npx tsx scripts/turbo-pipeline.ts --mode=full_curation --workers=20 --batch-size=5",
    "q:scrape-jee": "npx tsx scripts/bulk-scraper.ts --source=jee-mains",
    "q:scrape-neet": "npx tsx scripts/bulk-scraper.ts --source=neet",
    "q:scrape-board": "npx tsx scripts/bulk-scraper.ts --source=ncert",
    "q:stubs": "npx tsx scripts/distribution-manager.ts --stubs=5000",
    "q:seed": "npx wrangler d1 execute examcompass-questions --local --file=scripts/seed.sql",
    "q:report": "cat batch_pipeline_report.md"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.9.0",
    "framer-motion": "^12.34.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-player": "^2.16.0",
    "react-router": "^7.13.0",
    "react-router-dom": "^6.28.0",
    "react-youtube": "^10.1.0",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0"
  }
}