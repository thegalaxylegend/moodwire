  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "global-jsdom": "^29.0.0",
    "globals": "^16.5.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "react-doctor": "^0.2.14",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-ssg": "^28.3.0"
  },
  "optionalDependencies": {
    "electron": "^40.10.2",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.examcompass.app",
    "productName": "ExamCompass",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.js",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
