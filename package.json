{
  "name": "exam-compass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run blog:sync && npm run seo:regen && tsc -b && vite build && npm run build:ssr && node scripts/prerender-all.js && node scripts/generate-sitemap.js && node scripts/generate-rss.js && npm run seo:ping",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "ssg": "npm run build",
    "blog:sync": "node scripts/sync-blogs.js",
    "blog:images": "node scripts/repair-images.js",
    "blog:placeholders": "node scripts/generate-blog-placeholders.js",
    "seo:regen": "node scripts/sync-blogs.js && node scripts/generate-seo-manifest.js",
    "seo:ping": "node scripts/ping-indexnow.js",
    "seo:check": "node scripts/validate-seo.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:rules": "firebase deploy --only firestore",
    "electron:dev": "electron .",
    "electron:build": "electron-builder build --publish never",
    "cap:android": "npx cap add android && npx cap open android",
    "cap:sync": "npx cap sync"
  },
