    "clsx": "^2.1.1",
    "dompurify": "^3.4.7",
    "exa-js": "^2.13.0",
    "framer-motion": "^12.40.0",
    "groq-sdk": "^0.37.0",
    "html2pdf.js": "^0.14.0",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "katex": "^0.16.47",
    "lenis": "^1.3.23",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.15.0",
    "openai": "^6.39.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-ga4": "^2.1.0",
    "react-helmet-async": "^2.0.5",
    "react-latex-next": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.16.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-mathjax": "^7.1.0",
    "rehype-raw": "^7.0.0",
