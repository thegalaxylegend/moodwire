{
  "name": "exam-compass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npx tsx scripts/sanity-guard.ts && npm run blog:sync && npm run seo:regen && tsc -b && vite build && npm run build:ssr && node scripts/prerender-parallel.js && node scripts/generate-sitemap.js && npx tsx scripts/generate-rss.ts && npm run seo:ping",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "ssg": "npm run build",
    "sanity:check": "npx tsx scripts/sanity-guard.ts",
    "blog:sync": "npx tsx scripts/sync-blogs.ts",
    "blog:images": "node scripts/repair-images.js",
    "blog:placeholders": "node scripts/generate-blog-placeholders.js",
    "seo:regen": "npx tsx scripts/sync-blogs.ts && node scripts/generate-seo-manifest.js",
    "seo:ping": "node scripts/ping-indexnow.js",
    "seo:check": "node scripts/validate-seo.js",
    "seo:indexing": "npx tsx scripts/google-indexing.ts",
    "seo:schema": "npx tsx scripts/generate-schema.ts",
    "seo:gsc": "npx tsx scripts/google-search-console.ts",
    "seo:ga4": "npx tsx scripts/google-analytics.ts",
    "ai:optimize-seo": "npx tsx scripts/meta-optimizer.ts",
    "ai:refresh": "npx tsx scripts/auto-refresh-blogs.ts",
    "ai:repair": "npx tsx scripts/smart-repair.ts",
    "ai:trends": "npx tsx scripts/quality-tracker.ts",
    "ai:links": "npx tsx scripts/internal-linker.ts",
    "ai:duplicates": "npx tsx scripts/duplication-checker.ts",
    "ai:autopsy": "npx tsx scripts/failed-autopsy.ts",
    "ai:patterns": "npx tsx scripts/content-patterns.ts",
    "ai:changelog": "npx tsx scripts/self-changelog.ts",
    "ai:evolve": "npx tsx scripts/self-improve.ts",
    "ai:prompt": "npx tsx scripts/prompt-evolution.ts",
    "ai:decay": "npx tsx scripts/content-decay.ts",
    "social:threads": "npx tsx scripts/social/thread-generator.ts --recent",
    "social:shorts": "npx tsx scripts/social/shorts-generator.ts --recent",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:rules": "firebase deploy --only firestore",
    "electron:dev": "electron .",
    "electron:build": "electron-builder build --publish never",
    "cap:android": "npx cap add android && npx cap open android",
    "cap:sync": "npx cap sync && node scripts/clean-native-assets.js",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^7.2.0",
