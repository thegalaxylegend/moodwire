    "@tavily/core": "^0.7.2",
    "@types/jspdf": "^1.3.3",
    "@types/three": "^0.182.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.7.0",
    "framer-motion": "^12.24.10",
    "groq-sdk": "^0.37.0",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "katex": "^0.16.38",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.2",
    "openai": "^6.27.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-ga4": "^2.1.0",
    "react-helmet-async": "^2.0.5",
    "react-latex-next": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-player": "^3.4.0",
