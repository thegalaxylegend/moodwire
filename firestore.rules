rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /engine_questions/{question} {
      allow read: if true;
      allow write: if request.auth != null; 
    }

    match /system_ping/{ping} {
      allow read: if true;
      allow write: if false;
    }

    match /documents/{docId} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /user_topic_stats/{stat} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /diagnostic_results/{result} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /leaderboards/{season}/users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /mock_attempts/{attempt} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /syllabus/{syllabusItem} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /archives/{archiveId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /public_profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /saved_lectures/{lecture} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /video_progress/{progress} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /study_plans/{plan} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /user_timelines/{timeline} {
      allow read, delete: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    // Public Blog Metadata (Synced by Jules)
    match /content_metadata/{docId} {
      allow read: if true;
      allow write: if false; // Only Admin SDK (Jules) can write here
    }
  }
}
